# Copy to backend/.env for local FastAPI development.
DATABASE_URL=postgresql+psycopg://alpha_tiles:alpha_tiles@localhost:5432/alpha_tiles
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# VR / WebXR showroom settings. Production VR needs HTTPS (localhost is allowed for testing).
VR_ENABLED=true
VR_REQUIRE_HTTPS=true
VR_TELEPORT_ENABLED=true
VR_DEFAULT_MOVEMENT_SPEED=2.4
VR_ROOM_SCALE=1.0
# Comma-separated production web origins permitted to display VR configuration.
VR_ALLOWED_ORIGINS=
